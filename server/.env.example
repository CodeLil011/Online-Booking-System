# Copy this file, rename the copy to ".env", and fill in the real values.
# Ask the project owner for the real JWT_SECRET (do NOT post it on GitHub).
PORT=5000
JWT_SECRET=replace-with-the-secret-from-the-owner
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string (ask the project owner; do NOT post the real one)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/pound_reservations?appName=Cluster0

