### 1. Request a reset link for Maria (expect 200)
###    → then LOOK AT THE BACKEND TERMINAL for the simulated email and copy the token
###      (the long text after /reset-password/ in the link)
POST http://localhost:5000/api/auth/forgot-password
Content-Type: application/json

{
  "email": "maria.santos@gmail.com"
}

### 2. Unknown email (expect 200, SAME message, and NO email in the terminal)
POST http://localhost:5000/api/auth/forgot-password
Content-Type: application/json

{
  "email": "nobody.here@gmail.com"
}

### 3. Invalid email format (expect 400)
POST http://localhost:5000/api/auth/forgot-password
Content-Type: application/json

{
  "email": "not-an-email"
}

### 4. Fake token (expect 400 "invalid or has expired")
POST http://localhost:5000/api/auth/reset-password
Content-Type: application/json

{
  "token": "this-is-not-a-real-token",
  "newPassword": "Maria2026new"
}

### PASTE THE TOKEN FROM THE TERMINAL HERE (replace the text after the = sign)
@resetToken = 86ffdf73e2474bc6e5c28a5e905dd83a3c719f6c922b5d4cd00608a1976d0f7b

### 5. Real token but WEAK password (expect 400, the token still works afterwards)
POST http://localhost:5000/api/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "short"
}

### 6. Real token + valid password (expect 200)
POST http://localhost:5000/api/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "Maria2026new"
}

### 7. Use the SAME token again (expect 400: one-time use)
POST http://localhost:5000/api/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "Another2026pass"
}

### 8. Login with the NEW password (expect 200)
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "maria.santos@gmail.com",
  "password": "Maria2026new"
}
